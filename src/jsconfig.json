{
    "compilerOptions": {
        "baseUrl": "./src",
        "paths": {
            "@src/*": ["*"],
            "@components/*": ["components/*"],
            "@atoms/*": ["components/atoms/*"],
            "@molecules/*": ["components/molecules/*"],
            "@organisms/*": ["components/organisms/*"],
            "@templates/*": ["components/templates/*"],
            "@pages/*": ["components/pages/*"],

            "@api/*": ["api/*"],
            "@hooks/*": ["hooks/*"],
            "@utils/*": ["utils/*"],

            "@assets/*": ["assets/*"],
            "@img/*": ["assets/img/*"],
            "@icons/*": ["assets/icons/*"]
        }
    },
    "include": ["src"]
}
